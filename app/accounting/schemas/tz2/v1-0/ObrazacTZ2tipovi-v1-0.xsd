  <xsd:complexType name="sObrazacTZ2">
    <xsd:annotation>
      <xsd:documentation>Struktura TZ-2 obrasca</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element ref="meta:Metapodaci"/>
      <xsd:element name="Zaglavlje" type="sZaglavlje">
        <xsd:annotation>
          <xsd:documentation>Zaglavlje obrasca</xsd:documentation>
        </xsd:annotation>
        <xsd:unique name="OIB">
          <xsd:selector xpath="Obveznik | ObracunSastavio/PoslovniSubjekt"/>
          <xsd:field xpath="OIB"/>
        </xsd:unique>
      </xsd:element>
      <xsd:element name="Tijelo" type="sTijelo">
        <xsd:annotation>
          <xsd:documentation>Tijelo obrasca</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
    <xsd:attribute name="verzijaSheme" use="required" fixed="1.0"/>
  </xsd:complexType>
  <xsd:complexType name="sZaglavlje">
    <xsd:annotation>
      <xsd:documentation>Zaglavlje obrasca</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="Obveznik" type="sPoslovniSubjektProsirenoOpcina">
        <xsd:annotation>
          <xsd:documentation>Podaci o poslovnom subjektu za koji se podnosi obrazac</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="Razdoblje" type="sRazdoblje">
